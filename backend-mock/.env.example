# HTTP port used by the Node/Express API.
PORT=5000

# Exact origin of the React/Vite frontend. Express CORS uses this value
# to allow browser requests from the frontend and no other origin.
FRONTEND_URL=http://localhost:5173

# Firebase project used by the Firebase Admin SDK to verify ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local path to a service-account JSON file. Keep the real JSON file outside
# Git and never expose it to the React frontend. Production can use host credentials.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Future Google Sheets integration settings. They are not read by this mock backend yet.
SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id
SHEETS_STAFF_RANGE=Staff!A:C
SHEETS_EVENTS_RANGE=AttendanceEvents!A:C
